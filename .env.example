# ==============================================================================
# PreBase Environment Configuration Template
# ==============================================================================
#
# CANONICAL SECRET DOMAINS:
#
# 1. PREBASE DEVELOPMENT SECRETS:
#    - File location: PreBase repository root `.env` (this file when copied to `.env`).
#    - Purpose: Local source-development, testing, and developer execution.
#    - Scope: ONLY read by PreBase source-development instances when running from
#      the PreBase repository root. Never packaged, never committed, and NEVER
#      scanned from arbitrary opened user projects/workspaces.
#
# 2. USER BYO CREDENTIALS:
#    - Location: OS-backed SecretStorage (configured via PreBase Settings UI).
#    - Purpose: Individual user-supplied provider keys in packaged/installed PreBase.
#
# 3. PREBASE CLOUD / HOSTED SECRETS:
#    - Location: Supabase Edge Function Secrets (`supabase secrets set`).
#    - Purpose: Server-side hosted gateway execution. Values NEVER return to client.
#
# ==============================================================================
# LOCAL DEVELOPER PROVIDER KEYS (PreBase Source Root .env only)
# ==============================================================================

# Google Gemini API Key for Magnus agents, model discovery, and AI descriptions:
GEMINI_API_KEY=

# Optional Google API Key alias:
# GOOGLE_API_KEY=

# LinkUp API Key for agent web search in local development:
LINKUP_API_KEY=

# ==============================================================================
# PREBASE CLOUD (SUPABASE) CONFIGURATION
# ==============================================================================
# Public project URL and anon/publishable key only; never commit service role keys.
# SUPABASE_URL=https://mvfopbkhftgmcwdpqrww.supabase.co
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
