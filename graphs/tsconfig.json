{
  "extends": "../src/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "mocha"],
    "skipLibCheck": true,
    "preserveSymlinks": true
  },
  "include": [
    "src/common/types/**/*.ts",
    "src/common/constants/**/*.ts",
    "src/core/**/*.ts",
    "src/history/**/*.ts",
    "src/layouts/**/*.ts",
    "src/architecture/**/*.ts",
    "src/index.ts",
    "src/node.ts"
  ],
  "exclude": [
    "scripts",
    "src/host/**",
    "src/browser.ts",
    "src/tests/**"
  ]
}
