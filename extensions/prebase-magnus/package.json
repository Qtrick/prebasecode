{
  "name": "magnus",
  "displayName": "Agents",
  "description": "PreBase Agents AI chat \u2014 Gemini-backed language models and workspace tools",
  "version": "0.1.0",
  "publisher": "prebase",
  "license": "MIT",
  "engines": {
    "vscode": "^1.128.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguageModelChatProvider:magnus",
    "onChatParticipant:prebase.magnus.ask",
    "onChatParticipant:prebase.magnus.edit",
    "onChatParticipant:prebase.magnus.agent",
    "onCommand:prebase.magnus.describeFile",
    "onCommand:prebase.magnus.checkConfiguration",
    "onCommand:prebase.magnus.hasApiKey"
  ],
  "main": "./out/extension.js",
  "enabledApiProposals": [
    "defaultChatParticipant",
    "chatParticipantAdditions",
    "chatParticipantPrivate",
    "chatProvider",
    "languageModelSystem",
    "languageModelCapabilities",
    "languageModelThinkingPart"
  ],
	"contributes": {
		"languageModelChatProviders": [
			{
				"vendor": "magnus",
				"displayName": "Agents",
				"isDefault": true
			}
		],
		"chatViewsWelcome": [
			{
				"icon": "$(sparkle)",
				"title": "Agents",
				"content": "Ask, plan, edit, and verify with Agents.\n\nKeys load from the project `.env` — paste Gemini, OpenAI, Claude, or any listed provider (at least one).",
				"when": "!chatSetupHidden"
			}
		],
		"chatParticipants": [
      {
        "id": "prebase.magnus.ask",
        "name": "Agents",
        "fullName": "Agents",
        "description": "Ask Agents about your project (read-only)",
        "isDefault": true,
        "locations": [
          "panel"
        ],
        "modes": [
          "ask"
        ]
      },
      {
        "id": "prebase.magnus.edit",
        "name": "Agents",
        "fullName": "Agents",
        "description": "Edit code with Agents",
        "isDefault": true,
        "locations": [
          "panel"
        ],
        "modes": [
          "edit"
        ]
      },
      {
        "id": "prebase.magnus.agent",
        "name": "agent",
        "fullName": "Agents",
        "description": "Agent mode \u2014 plan, edit, and verify with Agents",
        "isDefault": true,
        "isAgent": true,
        "locations": [
          "panel"
        ],
        "modes": [
          "agent"
        ],
        "when": "config.chat.agent.enabled"
      }
    ],
    "commands": [
      {
        "command": "prebase.magnus.open",
        "title": "Open Agents",
        "category": "Agents"
      },
      {
        "command": "prebase.magnus.setApiKey",
        "title": "Open API Keys (.env)",
        "category": "Agents"
      },
      {
        "command": "prebase.magnus.clearApiKey",
        "title": "Clear Legacy API Key Secret",
        "category": "Agents"
      },
      {
        "command": "prebase.magnus.checkConfiguration",
        "title": "Check Configuration",
        "category": "Agents"
      },
      {
        "command": "prebase.magnus.newSession",
        "title": "New Session",
        "category": "Agents"
      },
      {
        "command": "prebase.magnus.selectModel",
        "title": "Select Model",
        "category": "Agents"
      },
      {
        "command": "prebase.magnus.selectMode",
        "title": "Select Mode",
        "category": "Agents"
      },
      {
        "command": "prebase.magnus.cancel",
        "title": "Cancel",
        "category": "Agents"
      },
      {
        "command": "prebase.magnus.attachCurrentFile",
        "title": "Attach Current File",
        "category": "Agents"
      },
      {
        "command": "prebase.magnus.attachGraphSelection",
        "title": "Attach Graph Selection",
        "category": "Agents"
      },
      {
        "command": "prebase.magnus.attachRuntimeContext",
        "title": "Attach Runtime Context",
        "category": "Agents"
      },
      {
        "command": "prebase.magnus.describeFile",
        "title": "Describe File (Graph)",
        "category": "Agents"
      },
      {
        "command": "prebase.magnus.hasApiKey",
        "title": "Has API Key",
        "category": "Agents"
      },
      {
        "command": "prebase.magnus.open.walkthrough",
        "title": "Open Walkthrough",
        "category": "Agents"
      },
      {
        "command": "prebase.magnus.refreshToken",
        "title": "Refresh Token",
        "category": "Agents"
      },
      {
        "command": "prebase.magnus.toggleStatusMenu",
        "title": "Toggle Status Menu",
        "category": "Agents"
      }
    ],
    "configuration": {
      "title": "Agents",
      "properties": {
        "prebase.magnus.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Agents AI chat."
        },
        "prebase.magnus.defaultModel": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "gemini-2.5-pro",
            "gemini-2.5-flash",
            "gemini-2.0-flash",
            "gemini-1.5-pro",
            "gemini-1.5-flash"
          ],
          "enumDescriptions": [
            "Auto",
            "Gemini 2.5 Pro",
            "Gemini 2.5 Flash",
            "Gemini 2.0 Flash",
            "Gemini 1.5 Pro",
            "Gemini 1.5 Flash"
          ],
          "description": "Default Agents language model."
        },
        "prebase.magnus.defaultMode": {
          "type": "string",
          "default": "ask",
          "enum": [
            "ask",
            "plan",
            "patch",
            "runtime",
            "agent"
          ],
          "enumDescriptions": [
            "Ask \u2014 read-only Q&A",
            "Plan \u2014 architecture planning without edits",
            "Edit \u2014 propose and apply code edits",
            "Test \u2014 runtime / UI testing focus",
            "Agent \u2014 full tool loop"
          ],
          "description": "Default Agents agent mode (Plan/Test map via this setting or Select Mode)."
        },
		"prebase.magnus.panelLocation": {
			"type": "string",
			"default": "sidebar",
			"enum": [
				"panel",
				"sidebar"
			],
			"description": "Preferred Agents chat panel location (sidebar = Agents auxiliary bar)."
		},
        "prebase.magnus.requireEditApproval": {
          "type": "boolean",
          "default": true,
          "description": "Require user approval before applying file edits."
        },
        "prebase.magnus.requireTerminalApproval": {
          "type": "boolean",
          "default": true,
          "description": "Require user approval before running terminal commands."
        },
        "prebase.magnus.maxToolIterations": {
          "type": "number",
          "default": 12,
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum tool-loop iterations per chat request."
        },
        "prebase.magnus.includeGraphContext": {
          "type": "boolean",
          "default": true,
          "description": "Include PreBase graph selection in chat context when available."
        },
        "prebase.magnus.includeRuntimeContext": {
          "type": "boolean",
          "default": true,
          "description": "Include Runtime Preview context in chat when available."
        }
      }
    }
  },
  "scripts": {
    "compile": "gulp compile-extension:prebase-magnus",
    "watch": "gulp watch-extension:prebase-magnus"
  },
  "devDependencies": {
    "@types/node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode.git"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ]
}
