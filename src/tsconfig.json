{
	// Phase D: graphs core paths live under graphs/src/{core,layouts,common,architecture} (symlink via prebase/graphs).
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"esModuleInterop": true,
		"removeComments": false,
		"preserveConstEnums": true,
		"sourceMap": false,
		"allowJs": true,
		"resolveJsonModule": true,
		"isolatedModules": false,
		"skipLibCheck": true,
		"preserveSymlinks": true,
		"outDir": "../out/vs",
		"types": [
			"@webgpu/types",
			"mocha",
			"semver",
			"sinon",
			"trusted-types",
			"winreg",
			"wicg-file-system-access"
		],
		"plugins": [
			{
				"name": "tsec",
				"exemptionConfig": "./tsec.exemptions.json"
			}
		]
	},
	"include": [
		"./*.ts",
		"./typings",
		"./vs/**/*.ts",
		"./vscode-dts/vscode.proposed.*.d.ts",
		"./vscode-dts/vscode.d.ts"
	],
	"exclude": [
		"vs/workbench/contrib/webview/browser/pre/service-worker.js",
		// Archived Architecture Graph assets reached through the graphs symlink. They are not
		// compiled into the workbench and are checked separately by `typecheck:graphs-preserved`.
		"vs/workbench/contrib/prebase/graphs/preserved/**",
		"vs/workbench/contrib/prebase/graphs/tests/**"
	]
}
