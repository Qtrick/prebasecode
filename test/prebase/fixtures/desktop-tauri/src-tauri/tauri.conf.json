{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "PreBase Tauri Fixture",
	"version": "0.0.0",
	"identifier": "com.prebase.desktop-tauri-fixture",
	"build": {
		"frontendDist": "../web",
		"devUrl": "http://127.0.0.1:1430",
		"beforeDevCommand": "python3 -m http.server 1430 --bind 127.0.0.1 --directory web"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "PreBase Tauri Fixture",
				"width": 640,
				"height": 480
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": false
	}
}
