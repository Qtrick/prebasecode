# Supabase CLI / local stack (copy to supabase/.env — gitignored)
# Hosted dev project ref: mvfopbkhftgmcwdpqrww

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Opt-in RLS runtime harness: dedicated non-production users only. The harness
# is inert when all PREBASE_RLS_TEST_* values are absent and refuses partial config.
# PREBASE_RLS_TEST_NON_PRODUCTION=acknowledged
# PREBASE_RLS_TEST_URL=
# PREBASE_RLS_TEST_PUBLISHABLE_KEY=
# PREBASE_RLS_TEST_USER_A_EMAIL=
# PREBASE_RLS_TEST_USER_A_PASSWORD=
# PREBASE_RLS_TEST_USER_B_EMAIL=
# PREBASE_RLS_TEST_USER_B_PASSWORD=
# Optional artifact directory (default: reports/rls-runtime/):
# PREBASE_RLS_TEST_ARTIFACT_DIR=

# NEVER commit service role, secret, or database passwords.
# Edge function secrets: `supabase secrets set` or Dashboard only.
